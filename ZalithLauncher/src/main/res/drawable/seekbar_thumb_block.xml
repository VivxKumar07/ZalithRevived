<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer border -->
    <item>
        <shape android:shape="rectangle">
            <size android:width="12dp" android:height="20dp"/>
            <solid android:color="#18191B"/>
        </shape>
    </item>
    <!-- Shadow bottom-right -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#585858"/>
        </shape>
    </item>
    <!-- Highlight top-left -->
    <item android:left="1dp" android:top="1dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    <!-- Face -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#C6C6C6"/>
        </shape>
    </item>
</layer-list>
