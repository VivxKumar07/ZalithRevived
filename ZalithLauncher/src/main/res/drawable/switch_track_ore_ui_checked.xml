<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer container border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#18191B"/>
            <size android:width="44dp" android:height="22dp"/>
        </shape>
    </item>
    <!-- Green background for left half -->
    <item android:left="1.5dp" android:top="1.5dp" android:right="22dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#386531"/>
        </shape>
    </item>
    <!-- Dark background for right half under thumb -->
    <item android:left="22dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#222426"/>
        </shape>
    </item>
    <!-- White vertical indicator line '|' on left -->
    <item android:left="10dp" android:top="6dp" android:right="32dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
        </shape>
    </item>
</layer-list>
