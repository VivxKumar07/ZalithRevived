<?xml version="1.0" encoding="utf-8"?>
<!-- Minecraft-style toggle OFF state: dark left half under thumb, gray right half with O indicator -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer dark border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#18191B"/>
            <size android:width="52dp" android:height="24dp"/>
        </shape>
    </item>
    <!-- Inner border -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#2A2B2D"/>
        </shape>
    </item>
    <!-- Dark background for thumb area (left half) -->
    <item android:left="2dp" android:top="2dp" android:right="26dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#222426"/>
        </shape>
    </item>
    <!-- Gray OFF background (right half) -->
    <item android:left="26dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#3A3B3D"/>
        </shape>
    </item>
    <!-- Centered square O symbol on gray right half (outer ring) -->
    <item android:left="32dp" android:top="6dp" android:right="8dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#777777"/>
        </shape>
    </item>
    <!-- O symbol inner cutout -->
    <item android:left="35dp" android:top="9dp" android:right="11dp" android:bottom="9dp">
        <shape android:shape="rectangle">
            <solid android:color="#3A3B3D"/>
        </shape>
    </item>
</layer-list>
