<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/inst_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_version_card"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <!-- Version Icon -->
    <ImageView
        android:id="@+id/inst_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:scaleType="centerInside"
        android:src="@drawable/img_minecraft"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_inst_play"
        app:layout_constraintStart_toEndOf="@id/inst_icon"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/inst_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="26.3 Vanilla" />

            <TextView
                android:id="@+id/inst_active_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/background_mod_category"
                android:fontFamily="@font/outfit"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                android:text="ACTIVE"
                android:textColor="#40C463"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/inst_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/outfit"
            android:textColor="#888888"
            android:textSize="11sp"
            tools:text="Vanilla • 26.3" />
    </LinearLayout>

    <!-- Play Button (3D layered green button) -->
    <com.movtery.zalithlauncher.ui.view.AnimButton
        android:id="@+id/btn_inst_play"
        android:layout_width="72dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/btn_minecraft_green"
        android:fontFamily="@font/outfit"
        android:text="Play"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_inst_more"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- More Options Button (...) -->
    <ImageButton
        android:id="@+id/btn_inst_more"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/btn_cubiq_dark"
        android:scaleType="centerInside"
        android:src="@drawable/ic_more"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#CCCCCC"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>
