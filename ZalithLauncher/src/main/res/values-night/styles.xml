<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/background_app</item>
        <item name="android:statusBarColor">@color/background_status_bar</item>
        <item name="android:navigationBarColor">@color/background_app</item>
        <item name="android:scrollbarThumbHorizontal">@color/background_menu_element</item>
        <item name="android:scrollbarThumbVertical">@color/background_menu_element</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#A0A0A5</item>
        <item name="colorAccent">#40C463</item>
        <item name="android:colorAccent">#40C463</item>
        <item name="switchStyle">@style/CubiqRectangularSwitch</item>
        <item name="android:switchStyle">@style/CubiqRectangularSwitch</item>
        <item name="seekBarStyle">@style/CubiqBlockSeekBar</item>
        <item name="android:seekBarStyle">@style/CubiqBlockSeekBar</item>
        <item name="dialogTheme">@style/CustomDialogStyle</item>
        <item name="android:dialogTheme">@style/CustomDialogStyle</item>
        <item name="alertDialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/CustomAlertDialogTheme</item>
    </style>

    <style name="Theme.ControlEditor" parent="AppTheme">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#A0A0A5</item>
        <item name="android:editTextColor">#FFFFFF</item>
        <item name="android:textColorHint">#666666</item>
        <item name="switchStyle">@style/CubiqRectangularSwitch</item>
        <item name="android:switchStyle">@style/CubiqRectangularSwitch</item>
        <item name="seekBarStyle">@style/CubiqBlockSeekBar</item>
        <item name="android:seekBarStyle">@style/CubiqBlockSeekBar</item>
    </style>

    <style name="CubiqRectangularSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/switch_thumb_rectangular</item>
        <item name="android:track">@drawable/switch_track_rectangular</item>
        <item name="track">@drawable/switch_track_rectangular</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
    </style>

    <style name="CubiqBlockSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:thumb">@drawable/seekbar_thumb_block</item>
        <item name="android:progressDrawable">@drawable/seekbar_track_line</item>
        <item name="android:splitTrack">false</item>
        <item name="android:thumbOffset">9dp</item>
    </style>

    <style name="Zl1SidebarSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/seekbar_zl1_progress</item>
        <item name="android:thumb">@drawable/seekbar_zl1_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:maxHeight">28dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:thumbOffset">10dp</item>
    </style>

    <style name="CustomDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#A0A0A5</item>
        <item name="android:colorAccent">#40C463</item>
        <item name="colorAccent">#40C463</item>
        <item name="android:scrollbarThumbHorizontal">@color/background_menu_element</item>
        <item name="android:scrollbarThumbVertical">@color/background_menu_element</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#A0A0A5</item>
        <item name="android:colorAccent">#40C463</item>
        <item name="colorAccent">#40C463</item>
        <item name="android:scrollbarThumbHorizontal">@color/background_menu_element</item>
        <item name="android:scrollbarThumbVertical">@color/background_menu_element</item>
    </style>

    <style name="RoundedCornersImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4%</item>
    </style>

    <style name="RoundImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ThickDivider">
        <item name="android:layout_height">2dp</item>
        <item name="android:background">?android:attr/listDivider</item>
    </style>
</resources>
